<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Arena.Label"
                android:layout_marginTop="0dp"
                android:text="First team or participant" />

            <Spinner
                android:id="@+id/spTeamA"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <TextView
                style="@style/Arena.Label"
                android:text="Second team or participant" />

            <Spinner
                android:id="@+id/spTeamB"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Arena.Label"
                        android:text="Date" />

                    <EditText
                        android:id="@+id/etMatchDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tap to choose"
                        android:inputType="none" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Arena.Label"
                        android:text="Time" />

                    <EditText
                        android:id="@+id/etMatchTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tap to choose"
                        android:inputType="none" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Arena.Label"
                android:text="Venue" />

            <EditText
                android:id="@+id/etVenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter venue"
                android:inputType="textCapWords" />

            <TextView
                style="@style/Arena.Label"
                android:text="Round or stage" />

            <EditText
                android:id="@+id/etRound"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="For example: League Round 1, Semi-final"
                android:inputType="textCapWords" />

            <TextView
                style="@style/Arena.Label"
                android:text="Asoo Core assigned to this match" />

            <Spinner
                android:id="@+id/spAssigned"
                android:layout_width="match_parent"
                android:layout_height="50dp" />

            <!-- Cricket fixtures only -->
            <LinearLayout
                android:id="@+id/panelLiveLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Arena.Label"
                    android:text="CricHeroes match link (optional)" />

                <EditText
                    android:id="@+id/etLiveLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="https://cricheroes.com/..."
                    android:inputType="textUri" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Create the match in CricHeroes, copy its link and paste it here. The match screen then shows an Open Live Score button."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSaveFixture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:text="Save" />
</LinearLayout>
