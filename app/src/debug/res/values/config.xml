<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        DEVELOPMENT VALUES - used only by debug builds (the ones Android Studio's Run
        button installs). They replace the values in app/src/main/res/values/config.xml.
        The address below is not a real mailbox; it only lets the first-Faculty set-up
        screen be tried out during development.
    -->
    <string name="faculty_email" translatable="false">faculty@flavium.test</string>
    <bool name="seed_dev_data">true</bool>

    <!--
        The address of the Firebase Local Emulator Suite, as the device reaches it
        (127.0.0.1 after "adb reverse tcp:8080 tcp:8080" and "adb reverse tcp:9099
        tcp:9099"). Empty: the real Firebase project. Release builds do not have this
        setting at all.
    -->
    <string name="firebase_emulator_host" translatable="false"></string>
</resources>
