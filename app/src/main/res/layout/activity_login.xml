<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Step 1: choose the kind of account -->
            <LinearLayout
                android:id="@+id/panelRoles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Arena.Body"
                    android:text="Organisers log in here. Choose the role you were given. Choosing a role does not grant it: your account decides what you can do." />

                <include
                    android:id="@+id/roleFaculty"
                    layout="@layout/item_link_card" />

                <include
                    android:id="@+id/roleCore"
                    layout="@layout/item_link_card" />

                <include
                    android:id="@+id/roleAsoo"
                    layout="@layout/item_link_card" />

                <include
                    android:id="@+id/roleCaptain"
                    layout="@layout/item_link_card" />

                <TextView
                    android:id="@+id/btnSetupFaculty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Set up the first Faculty account"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    style="@style/Arena.Body"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Just here to follow the festival? You do not need an account. Go back and browse freely." />
            </LinearLayout>

            <!-- Step 2: email and password for the chosen role -->
            <LinearLayout
                android:id="@+id/panelForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFormHint"
                    style="@style/Arena.Body"
                    android:text="Enter the email and password of your account." />

                <TextView
                    style="@style/Arena.Label"
                    android:text="Email" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter email"
                    android:inputType="textEmailAddress" />

                <TextView
                    style="@style/Arena.Label"
                    android:text="Password" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Enter password"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Log in" />

                <TextView
                    android:id="@+id/btnChangeRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="14dp"
                    android:text="Choose a different role"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Development helper: shown only in builds that seed development data -->
                <LinearLayout
                    android:id="@+id/panelDev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_banner"
                        android:padding="12dp"
                        android:text="@string/dev_banner"
                        android:textColor="@color/banner_text"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnFillDev"
                        style="@style/Widget.Arena.Button.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Fill in the development account" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
