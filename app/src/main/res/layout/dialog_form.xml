<?xml version="1.0" encoding="utf-8"?>
<!-- The form behind FormDialog: two lists, five numbers, one text box and a tick box.
     Every part starts hidden; FormDialog shows the parts a screen asks for. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/tvDialogChoiceLabel"
            style="@style/Arena.Label"
            android:text="Choose" />

        <Spinner
            android:id="@+id/spDialogChoice"
            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <TextView
            android:id="@+id/tvDialogChoice2Label"
            style="@style/Arena.Label"
            android:text="Choose" />

        <Spinner
            android:id="@+id/spDialogChoice2"
            android:layout_width="match_parent"
            android:layout_height="50dp" />

        <TextView
            android:id="@+id/tvNumber1Label"
            style="@style/Arena.Label"
            android:text="Number" />

        <EditText
            android:id="@+id/etNumber1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:id="@+id/tvNumber2Label"
            style="@style/Arena.Label"
            android:text="Number" />

        <EditText
            android:id="@+id/etNumber2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:id="@+id/tvNumber3Label"
            style="@style/Arena.Label"
            android:text="Number" />

        <EditText
            android:id="@+id/etNumber3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:id="@+id/tvNumber4Label"
            style="@style/Arena.Label"
            android:text="Number" />

        <EditText
            android:id="@+id/etNumber4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:id="@+id/tvNumber5Label"
            style="@style/Arena.Label"
            android:text="Number" />

        <EditText
            android:id="@+id/etNumber5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:id="@+id/tvDialogTextLabel"
            style="@style/Arena.Label"
            android:text="Text" />

        <EditText
            android:id="@+id/etDialogText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:maxLines="1" />

        <CheckBox
            android:id="@+id/cbDialogTick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
