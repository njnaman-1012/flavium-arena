<?xml version="1.0" encoding="utf-8"?>
<!-- Add or edit a branch: its name and short code, and removing it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvBranchState"
                style="@style/Arena.Body"
                android:visibility="gone" />

            <TextView
                style="@style/Arena.Label"
                android:text="Branch name" />

            <EditText
                android:id="@+id/etBranchName"
                style="@style/Widget.Arena.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="For example: Computer Engineering"
                android:inputType="textCapWords" />

            <TextView
                style="@style/Arena.Label"
                android:text="Short code" />

            <EditText
                android:id="@+id/etBranchCode"
                style="@style/Widget.Arena.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="For example: CE"
                android:inputType="textCapCharacters"
                android:maxLength="8" />

            <Button
                android:id="@+id/btnSaveBranch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Save changes" />

            <Button
                android:id="@+id/btnRemoveBranch"
                style="@style/Widget.Arena.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Remove branch"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnRestoreBranch"
                style="@style/Widget.Arena.Button.Soft"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Restore branch"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
