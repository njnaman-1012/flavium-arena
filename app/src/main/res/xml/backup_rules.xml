<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 and older. Nothing of this app is backed up: the local database is only a
   copy of the festival, so a new installation always starts empty and fetches the
   festival from the server. (allowBackup="false" in the manifest already turns backup
   off; these rules say the same in case it is ever switched on.)
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
