<resources>
    <!-- The app uses one light theme. Buttons, text fields and spinners get their
         look from the styles named here, so layouts do not repeat it. -->
    <style name="Base.Theme.FlaviumArena" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="homeAsUpIndicator">@drawable/ic_back</item>
        <item name="materialButtonStyle">@style/Widget.Arena.Button</item>
        <item name="editTextStyle">@style/Widget.Arena.Input</item>
        <item name="spinnerStyle">@style/Widget.Arena.Spinner</item>
        <item name="toolbarStyle">@style/Widget.Arena.Toolbar</item>
    </style>

    <style name="Theme.FlaviumArena" parent="Base.Theme.FlaviumArena" />

    <!-- Buttons: pill shaped. Primary is filled indigo, Soft is pale lavender. -->
    <style name="Widget.Arena.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <style name="Widget.Arena.Button.Soft">
        <item name="backgroundTint">@color/primary_soft</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
    </style>

    <style name="Widget.Arena.Button.Danger">
        <item name="backgroundTint">@color/danger_soft</item>
        <item name="android:textColor">@color/danger</item>
    </style>

    <style name="Widget.Arena.Button.Small">
        <item name="android:minHeight">44dp</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/primary_soft</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Text fields and spinners: white with a rounded grey outline. -->
    <style name="Widget.Arena.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="Widget.Arena.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">40dp</item>
    </style>

    <style name="Widget.Arena.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Arena.ToolbarTitle</item>
        <item name="android:background">@color/surface</item>
    </style>

    <style name="TextAppearance.Arena.ToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Text styles used directly in layouts. "Arena" is the empty parent of the ones below. -->
    <style name="Arena" />
    <style name="Arena.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Arena.PageTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Arena.SectionTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Arena.Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Bottom bar: no pill behind the selected icon -->
    <style name="Widget.Arena.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Rounded pop-up used by confirm and message dialogs -->
    <style name="ThemeOverlay.Arena.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
