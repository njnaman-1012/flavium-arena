<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (see DevTools in app/src/debug): the development login helper. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_banner"
        android:padding="12dp"
        android:text="Debug build: a development account is available for testing."
        android:textColor="@color/banner_text"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnFillDev"
        style="@style/Widget.Arena.Button.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Fill in the development account" />
</LinearLayout>
