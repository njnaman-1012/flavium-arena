<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. The Firebase emulators on the development computer speak plain
     http, which Android refuses by default. Release builds do not get this setting and
     only ever talk to Firebase over https. The permission self-test screen is part of
     debug builds only as well. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:usesCleartextTraffic="true">
        <activity android:name=".ui.admin.SelfTestActivity" />
    </application>

</manifest>
